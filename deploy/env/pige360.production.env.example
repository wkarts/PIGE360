# PIGE360 — ambiente de produção
# Branch: main
# Imagens: release SemVer oficial; nunca use develop/latest neste ambiente.
# Domínio canônico: *.pige360.com.br

PIGE360_ENVIRONMENT=production
PIGE360_DEPLOY_TARGET=cloudpanel
PIGE360_IMAGE_MODE=registry
PIGE360_PROJECT_NAME=pige360-production
APP_ENV=production
APP_VERSION=1.1.2
APP_DEMO_MODE=false
PIGE360_IMAGE_REGISTRY=ghcr.io/wkarts
PIGE360_IMAGE_TAG=1.1.2
PIGE360_PULL_POLICY=always
PIGE360_SECRETS_DIR=./runtime-secrets/production
PIGE360_DATA_ROOT=./volumes/production
PIGE360_DATA_MODE=bind
PIGE360_NETWORK_APP_NAME=pige360-production-app
PIGE360_NETWORK_DATA_NAME=pige360-production-data
PIGE360_NETWORK_OBSERVABILITY_NAME=pige360-production-observability
PIGE360_NETWORK_BUILD_FARM_NAME=pige360-production-build-farm
APP_TIMEZONE=America/Bahia
PIGE360_STARTUP_TIMEOUT_SECONDS=600
PIGE360_READINESS_ATTEMPTS=60
PIGE360_READINESS_DELAY_SECONDS=5
PIGE360_WORKER_CONCURRENCY=2
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

PIGE360_BASE_DOMAIN=pige360.com.br
PLATFORM_CONSOLE_HOST=console.pige360.com.br
PLATFORM_API_HOST=api.pige360.com.br
PLATFORM_BRANDING_HOST=branding.pige360.com.br
PLATFORM_DOWNLOADS_HOST=downloads.pige360.com.br
PLATFORM_OPS_HOST=ops.pige360.com.br
TENANT_DEFAULT_BASE_DOMAIN=pige360.com.br
TENANT_WILDCARD_HOST=*.pige360.com.br
TENANT_CANONICAL_HOST_TEMPLATE={tenant}.pige360.com.br
TENANT_CUSTOM_DOMAINS_ENABLED=true
TENANT_CUSTOM_DOMAIN_CNAME_TARGET=edge.pige360.com.br
TENANT_RESERVED_SLUGS=www,api,console,branding,downloads,ops,edge,status,assets,cdn,mail,smtp,imap,admin,control,platform
ALLOWED_PLATFORM_HOSTS=console.platform.local,api.platform.local,pige360-api,console.pige360.com.br,api.pige360.com.br,branding.pige360.com.br,downloads.pige360.com.br
CORS_ALLOWED_ORIGINS=https://console.pige360.com.br

# Publicação local para CloudPanel/Dockge. O Edge Traefik usa a rede Docker diretamente.
WEB_BIND_HOST=127.0.0.1
WEB_PUBLISHED_PORT=58080
API_BIND_HOST=127.0.0.1
API_PUBLISHED_PORT=58000
CONTROL_WEB_BIND_HOST=127.0.0.1
CONTROL_WEB_PUBLISHED_PORT=58081
OPS_BIND_HOST=127.0.0.1
OPS_PUBLISHED_PORT=53000

# Edge / TLS
TRAEFIK_IMAGE=traefik:v3.7.12
TRAEFIK_BIND_HOST=0.0.0.0
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
PIGE360_EDGE_TLS_MODE=cloudflare
PIGE360_ALLOW_INSECURE_HTTP=false
ACME_ENABLED=true
ACME_EMAIL=infra@pige360.com.br
CLOUDFLARE_ENABLED=false
CLOUDFLARE_SAAS_ENABLED=false
CLOUDFLARE_TUNNELS_ENABLED=false
CLOUDFLARE_CONTROL_ZONE_ID=
CLOUDFLARE_TENANT_ZONE_ID=
# O segredo fica em runtime-secrets/cloudflare_api_token.txt.

# Connect API / comunicações Meta-compatible
CONNECT_API_ENABLED=false
CONNECT_API_BASE_URL=
CONNECT_API_SECRET_REFERENCE=connect_api_key
CONNECT_API_META_COMPATIBLE=true
# O segredo fica em runtime-secrets/connect_api_key.txt.

# Observabilidade
# O collector permanece opcional (profile "otel"); o backend ainda nao emite OTLP.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://pige360-otel-collector:4317
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
LOKI_INTERNAL_URL=http://pige360-loki:3100
GRAFANA_ENABLED=true
ALLOY_ENABLED=true
