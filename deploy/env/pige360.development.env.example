APP_ENV=development
APP_VERSION=1.0.0
PIGE360_IMAGE_REGISTRY=ghcr.io/wkarts
PIGE360_IMAGE_TAG=develop
PIGE360_SECRETS_DIR=./runtime-secrets
APP_TIMEZONE=America/Bahia

# Domínio-base deste ambiente. Troque livremente sem editar YAML.
PIGE360_BASE_DOMAIN=dev.pige360.com.br
PLATFORM_CONSOLE_HOST=console.dev.pige360.com.br
PLATFORM_API_HOST=api.dev.pige360.com.br
PLATFORM_OPS_HOST=ops.dev.pige360.com.br
TENANT_DEFAULT_BASE_DOMAIN=dev.pige360.com.br
TENANT_WILDCARD_HOST=*.dev.pige360.com.br
TENANT_CANONICAL_HOST_TEMPLATE={tenant}.dev.pige360.com.br
TENANT_CUSTOM_DOMAINS_ENABLED=true
TENANT_CUSTOM_DOMAIN_CNAME_TARGET=edge.dev.pige360.com.br
TENANT_RESERVED_SLUGS=www,api,console,ops,edge,status,assets,cdn,mail,smtp,imap,admin,control,platform
ALLOWED_PLATFORM_HOSTS=console.dev.pige360.com.br,api.dev.pige360.com.br
CORS_ALLOWED_ORIGINS=https://console.dev.pige360.com.br

WEB_BIND_HOST=127.0.0.1
WEB_PUBLISHED_PORT=58080
API_BIND_HOST=127.0.0.1
API_PUBLISHED_PORT=58000
CONTROL_WEB_BIND_HOST=127.0.0.1
CONTROL_WEB_PUBLISHED_PORT=58081
OPS_BIND_HOST=127.0.0.1
OPS_PUBLISHED_PORT=53000

TRAEFIK_IMAGE=traefik:v3.7.12
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
ACME_EMAIL=infra@pige360.com.br
CLOUDFLARE_ENABLED=false
CLOUDFLARE_SAAS_ENABLED=false
CLOUDFLARE_TUNNELS_ENABLED=false
CLOUDFLARE_CONTROL_ZONE_ID=
CLOUDFLARE_TENANT_ZONE_ID=

CONNECT_API_ENABLED=false
CONNECT_API_BASE_URL=
CONNECT_API_SECRET_REFERENCE=connect_api_key
CONNECT_API_META_COMPATIBLE=true

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://pige360-otel-collector:4317
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
LOKI_INTERNAL_URL=http://pige360-loki:3100
GRAFANA_ENABLED=true
ALLOY_ENABLED=true
