logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "pige360" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "pige360" {
  targets = discovery.docker.pige360.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "pige360"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "platform"
    replacement  = "pige360"
  }
}

loki.source.docker "pige360" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.pige360.output
  forward_to = [loki.process.pige360.receiver]
}

loki.process "pige360" {
  stage.docker {}

  stage.json {
    expressions = {
      event       = "event",
      level       = "level",
      plane       = "plane",
      tenant_id   = "tenant_id",
      tenant_code = "tenant_code",
    }
  }

  // Somente campos de baixa cardinalidade viram labels. correlation_id e host
  // permanecem no JSON para pesquisa, evitando explosão do índice do Loki.
  stage.labels {
    values = {
      event       = "",
      level       = "",
      plane       = "",
      tenant_id   = "",
      tenant_code = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://pige360-loki:3100/loki/api/v1/push"
  }
}
