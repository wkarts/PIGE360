# Referência para vhosts do CloudPanel. O CloudPanel continua responsável por TLS.
# Ajuste os includes/caminhos gerados pelo próprio painel; preserve o roteamento abaixo.

# Tenant wildcard: <tenant>.pige360.com.br
server {
    listen 443 ssl http2;
    server_name *.pige360.com.br;
    client_max_body_size 25m;

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://127.0.0.1:58000;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://127.0.0.1:58080;
    }
}

# Control Plane
