# Configuração local do aplicativo PIGE360 Deployer.
# Dados do deployment PIGE360 são escolhidos na interface e transmitidos ao
# agente remoto somente durante a operação.

PIGE360_DEPLOYER_TRAY_ENABLED=true
PIGE360_DEPLOYER_TRAY_MINIMIZE_TO_TRAY=true
PIGE360_DEPLOYER_TRAY_CLOSE_TO_TRAY=false
PIGE360_DEPLOYER_START_WITH_WINDOWS=false

# Serviços genéricos herdados da base ficam desligados neste produto.
PIGE360_DEPLOYER_API_AUTO_START=false
PIGE360_DEPLOYER_WEB_AUTO_START=false
PIGE360_DEPLOYER_WEBHOOK_AUTO_START=false
PIGE360_DEPLOYER_WEBSOCKET_AUTO_START=false
PIGE360_DEPLOYER_SERVICES_AUTO_START=false
