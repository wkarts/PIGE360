# APP
APP_NAME=PIGE360
APP_FULL_NAME=PIGE360 — Plataforma Integrada de Gestão Educacional
APP_VERSION=1.0.0
PIGE360_IMAGE_TAG=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_DEMO_MODE=false
APP_TIMEZONE=America/Bahia
APP_LOCALE=pt-BR
APP_DATA_ROOT=/var/lib/pige360
APP_STORAGE_ROOT=/var/lib/pige360/tenants
APP_CONTROL_DB_PATH=/var/lib/pige360/control/platform-control.db
APP_BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token
APP_JWT_SECRET_FILE=/run/secrets/app_jwt_secret
APP_JWT_ISSUER=pige360
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=30

# PLATFORM / DOMAINS
PIGE360_BASE_DOMAIN=pige360.com.br
PLATFORM_CONTROL_BASE_DOMAIN=pige360.com.br
PLATFORM_CONSOLE_HOST=console.pige360.com.br
PLATFORM_API_HOST=api.pige360.com.br
PLATFORM_OPS_HOST=ops.pige360.com.br
TENANT_DEFAULT_BASE_DOMAIN=pige360.com.br
TENANT_WILDCARD_HOST=*.pige360.com.br
TENANT_CANONICAL_HOST_TEMPLATE={tenant}.pige360.com.br
TENANT_CUSTOM_DOMAINS_ENABLED=true
TENANT_CUSTOM_DOMAIN_CNAME_TARGET=edge.pige360.com.br
TENANT_RESERVED_SLUGS=www,api,console,ops,edge,status,assets,cdn,mail,smtp,imap,admin,control,platform
ALLOWED_PLATFORM_HOSTS=console.pige360.com.br,api.pige360.com.br
CORS_ALLOWED_ORIGINS=https://console.pige360.com.br

# PLATFORM_BRANDING
PRODUCT_NAME=PIGE360
PRODUCT_FULL_NAME=PIGE360 — Plataforma Integrada de Gestão Educacional
PRODUCT_SLUG=pige360
PRODUCT_PUBLISHER=ARGWS / WWSoftwares
PRODUCT_IDENTIFIER_PREFIX=br.com.argws.pige360

# TENANT_BRANDING
TENANT_BRANDING_ENABLED=true
TENANT_CO_BRANDING_DEFAULT=false
TENANT_BRAND_ASSET_MAX_MB=20

# APP_FACTORY / DISTRIBUTION / BUILD_FARM
APP_FACTORY_ENABLED=true
APP_DISTRIBUTION_ENABLED=true
BUILD_FARM_ENABLED=true
BUILD_FARM_LOCAL_ONLY=true
REMOTE_CI_ENABLED=false
REMOTE_REGISTRY_ENABLED=false
REMOTE_RELEASE_ENABLED=false
REMOTE_DEPLOY_ENABLED=false
INTEGRATION_REMOTE_ENABLED=false
OCI_REGISTRY=ghcr.io/wkarts

# DATABASE_CONTROL / DATABASE_TENANT
DATABASE_CONTROL_URL=postgresql+asyncpg://pige360_control@pige360-postgres-control:5432/platform_control
DATABASE_CONTROL_PASSWORD_FILE=/run/secrets/postgres_control_password
DATABASE_TENANT_ADMIN_URL=postgresql+asyncpg://pige360_tenant_admin@pige360-postgres-tenants:5432/postgres
DATABASE_TENANT_ADMIN_PASSWORD_FILE=/run/secrets/postgres_tenant_password
DATABASE_SECRET_KEY_FILE=/run/secrets/database_secret_key
DATABASE_TENANT_URL_TEMPLATE=postgresql+asyncpg://{user}@pige360-postgres-tenants:5432/{database}
DATABASE_LOCAL_TEST_ADAPTER=sqlite

# REDIS / RABBITMQ / MINIO
REDIS_URL=redis://pige360-redis:6379/0
REDIS_PASSWORD_FILE=/run/secrets/redis_password
RABBITMQ_URL=amqp://pige360@pige360-rabbitmq:5672/pige360
RABBITMQ_PASSWORD_FILE=/run/secrets/rabbitmq_password
WORKER_CONTEXT_SIGNING_KEY_FILE=/run/secrets/worker_context_signing_key
MINIO_ENDPOINT=http://pige360-minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key

# CLOUDFLARE / ACME / EDGE
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token
CLOUDFLARE_CONTROL_ZONE_ID=
CLOUDFLARE_TENANT_ZONE_ID=
CLOUDFLARE_SAAS_ENABLED=false
CLOUDFLARE_TUNNELS_ENABLED=false
ACME_ENABLED=true
ACME_PROVIDER=lets_encrypt
ACME_EMAIL=infra@pige360.com.br
TRAEFIK_IMAGE=traefik:v3.7.12
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# CONNECT API / COMMUNICATIONS (Meta-compatible)
CONNECT_API_ENABLED=false
CONNECT_API_BASE_URL=
CONNECT_API_KEY_FILE=/run/secrets/connect_api_key
CONNECT_API_SECRET_REFERENCE=connect_api_key
CONNECT_API_META_COMPATIBLE=true
CONNECT_API_WEBHOOK_REPLAY_PROTECTION=true
CONNECT_API_DEDUPLICATION=true

# MAILCOW / IMAP / SMTP
MAIL_MODE=disabled
MAILCOW_API_URL=
MAILCOW_API_KEY_FILE=/run/secrets/mailcow_api_key
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls

# CONTRACTS / SIGNATURES
CONTRACTS_ENABLED=true
SIGNATURE_INTERNAL_ENABLED=true
ICP_BRASIL_ENABLED=false
SIGNATURE_INTERNAL_OTP_REQUIRED=true
SIGNATURE_OTP_TTL_SECONDS=300
SIGNATURE_OTP_MAX_ATTEMPTS=5
GOVBR_SIGNATURE_ENABLED=false
GOVBR_SIGNATURE_ENVIRONMENT=homologation
GOVBR_SIGNATURE_CLIENT_ID=
GOVBR_SIGNATURE_CLIENT_SECRET_FILE=/run/secrets/govbr_client_secret
GOVBR_SIGNATURE_REDIRECT_URI=
GOVBR_SIGNATURE_SCOPE=sign

# BANKING / FISCAL / IBPT
BANKING_ENABLED=false
FISCAL_ENABLED=false
FISCAL_ENVIRONMENT=homologation
IBPT_PROVIDER=wwsoftwares
IBPT_API_BASE_URL=https://ibpt.wwsoftwares.com.br
IBPT_API_UF_PATH=/tabela/ibpt/{uf}
IBPT_SYNC_ENABLED=false

# LESSON_PLANNING / CLASS_ATTENDANCE
LESSON_PLANNING_APPROVAL_REQUIRED=true
LESSON_PLANNING_OFFLINE_ENABLED=true
CLASS_ATTENDANCE_OFFLINE_ENABLED=true
ATTENDANCE_NOTIFICATION_DELAY_MINUTES=15

# NATIVE / STORES — congelado; execução somente manual
ANDROID_SIGNING_ENABLED=false
ANDROID_KEYSTORE_FILE=
PLAY_CONSOLE_ENABLED=false
PLAY_SERVICE_ACCOUNT_JSON_FILE=
IOS_SIGNING_ENABLED=false
APPLE_CERTIFICATE_FILE=
APP_STORE_CONNECT_ENABLED=false
APP_STORE_CONNECT_KEY_FILE=

# OBSERVABILITY / BACKUP / SECURITY
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://pige360-otel-collector:4317
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
LOKI_INTERNAL_URL=http://pige360-loki:3100
GRAFANA_ENABLED=true
ALLOY_ENABLED=true
BACKUP_ENABLED=true
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
TRUSTED_PROXY_CIDRS=127.0.0.1/32
BUILD_FARM_TOKEN_FILE=/run/secrets/build_farm_token

# WORKFLOWS
WORKFLOW_SLA_INTERVAL_SECONDS=60
