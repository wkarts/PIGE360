{
  "module": "inventory",
  "architecture": "modular-monolith",
  "tenant_scoped": true,
  "audit_required": true,
  "outbox_required": true,
  "resources": [
    {
      "name": "inventory_items",
      "path": "inventory/items",
      "initial_state": "active",
      "transitions": {
        "active": [
          "inactive",
          "archived"
        ],
        "inactive": [
          "active",
          "archived"
        ]
      },
      "event_prefix": "InventoryItem",
      "roles": [
        "inventory_manager"
      ]
    }
  ]
}
