FROM rust:1.88.0-bookworm
ARG VERSION=1.1.2
LABEL org.opencontainers.image.title="pige360-base-rust-tauri" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="local-workspace"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev clang cmake curl git unzip \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 pige360 && useradd --system --uid 10001 --gid pige360 --home /opt/pige360 pige360
WORKDIR /opt/pige360
USER 10001:10001
