FROM debian:bookworm-slim
ARG VERSION=1.0.0-alpha.1
LABEL org.opencontainers.image.title="pige360-base-runtime" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="local-workspace"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini libssl3 libsqlite3-0 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 pige360 && useradd --system --uid 10001 --gid pige360 --home /opt/pige360 pige360
WORKDIR /opt/pige360
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini","--"]
