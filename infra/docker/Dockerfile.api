ARG PYTHON_BASE_IMAGE=pige360-base-python:1.0.0-alpha.1
FROM ${PYTHON_BASE_IMAGE} AS build
USER root
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY backend/pyproject.toml backend/requirements.lock backend/requirements.production.lock ./
RUN python -m venv /venv && /venv/bin/pip install --no-cache-dir -r requirements.lock -r requirements.production.lock
FROM ${PYTHON_BASE_IMAGE}
ARG VERSION=1.0.0-alpha.1
LABEL org.opencontainers.image.title="pige360-api" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="local-workspace"
COPY --from=build /venv /venv
COPY backend /opt/pige360/backend
WORKDIR /opt/pige360/backend
ENV PATH=/venv/bin:$PATH PYTHONPATH=/opt/pige360/backend APP_DATA_ROOT=/var/lib/pige360
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--proxy-headers","--forwarded-allow-ips=127.0.0.1"]
