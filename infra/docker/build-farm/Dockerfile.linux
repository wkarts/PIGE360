FROM node:22.14.0-bookworm-slim AS node
FROM rust:1.88.0-bookworm
ARG TAURI_CLI_VERSION=2.3.1
ARG VERSION=1.0.0
LABEL org.opencontainers.image.title="pige360-builder-linux" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.source="local-workspace"
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates curl build-essential pkg-config libssl-dev libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev librsvg2-dev clang cmake zip unzip \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/ /usr/local/
RUN cargo install tauri-cli --version ${TAURI_CLI_VERSION} --locked \
 && groupadd --system --gid 10001 pige360 \
 && useradd --system --uid 10001 --gid pige360 --home /home/pige360 --create-home pige360
COPY scripts/build-farm/agent.py /opt/pige360/agent.py
WORKDIR /workspace
USER 10001:10001
ENTRYPOINT ["python3","/opt/pige360/agent.py"]
