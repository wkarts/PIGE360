x-worker-image: &worker-image
  image: ${PIGE360_WORKER_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-worker:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
  pull_policy: ${PIGE360_PULL_POLICY:-missing}

services:
  pige360-app-init:
    image: ${PIGE360_MIGRATIONS_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-migrations:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}
    environment:
      APP_ENV: production
      ALLOWED_PLATFORM_HOSTS: console.platform.local,api.platform.local,pige360-api,${PLATFORM_CONSOLE_HOST:-console.pige360.com.br},${PLATFORM_API_HOST:-api.pige360.com.br},${PLATFORM_BRANDING_HOST:-branding.pige360.com.br},${PLATFORM_DOWNLOADS_HOST:-downloads.pige360.com.br}
      PIGE360_BASE_DOMAIN: ${PIGE360_BASE_DOMAIN:-pige360.com.br}
      TENANT_DEFAULT_BASE_DOMAIN: ${TENANT_DEFAULT_BASE_DOMAIN:-pige360.com.br}
      TENANT_CUSTOM_DOMAINS_ENABLED: ${TENANT_CUSTOM_DOMAINS_ENABLED:-true}
      PIGE360_SKIP_MIGRATIONS: ${PIGE360_SKIP_MIGRATIONS:-false}

  pige360-api:
    image: ${PIGE360_API_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-api:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}
    environment:
      APP_ENV: production
      ALLOWED_PLATFORM_HOSTS: console.platform.local,api.platform.local,pige360-api,${PLATFORM_CONSOLE_HOST:-console.pige360.com.br},${PLATFORM_API_HOST:-api.pige360.com.br},${PLATFORM_BRANDING_HOST:-branding.pige360.com.br},${PLATFORM_DOWNLOADS_HOST:-downloads.pige360.com.br}
      PIGE360_BASE_DOMAIN: ${PIGE360_BASE_DOMAIN:-pige360.com.br}
      TENANT_DEFAULT_BASE_DOMAIN: ${TENANT_DEFAULT_BASE_DOMAIN:-pige360.com.br}
      TENANT_CUSTOM_DOMAINS_ENABLED: ${TENANT_CUSTOM_DOMAINS_ENABLED:-true}
      CONNECT_API_ENABLED: ${CONNECT_API_ENABLED:-false}
      CONNECT_API_BASE_URL: ${CONNECT_API_BASE_URL:-}
      CONNECT_API_META_COMPATIBLE: ${CONNECT_API_META_COMPATIBLE:-true}
      CLOUDFLARE_SAAS_ENABLED: ${CLOUDFLARE_SAAS_ENABLED:-false}
      CLOUDFLARE_TENANT_ZONE_ID: ${CLOUDFLARE_TENANT_ZONE_ID:-}
      CLOUDFLARE_API_TOKEN_FILE: /run/secrets/cloudflare_api_token
      LOKI_INTERNAL_URL: ${LOKI_INTERNAL_URL:-http://pige360-loki:3100}
    secrets:
      - connect_api_key
      - cloudflare_api_token
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          memory: 512M

  pige360-worker-integrations:
    <<: *worker-image
    profiles: [dedicated-workers]
    environment:
      CONNECT_API_ENABLED: ${CONNECT_API_ENABLED:-false}
      CONNECT_API_BASE_URL: ${CONNECT_API_BASE_URL:-}
      CONNECT_API_META_COMPATIBLE: ${CONNECT_API_META_COMPATIBLE:-true}
    secrets:
      - connect_api_key

  pige360-web:
    image: ${PIGE360_WEB_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-web:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M

  pige360-platform-console:
    image: ${PIGE360_PLATFORM_CONSOLE_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-platform-console:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}

  pige360-branding-studio:
    image: ${PIGE360_BRANDING_STUDIO_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-branding-studio:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}

  pige360-tenant-download-center:
    image: ${PIGE360_TENANT_DOWNLOAD_CENTER_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-tenant-download-center:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}

  # O App Factory executa o mesmo backend da API com APP_PROCESS_ROLE próprio.
  pige360-app-factory-api:
    image: ${PIGE360_APP_FACTORY_IMAGE:-${PIGE360_IMAGE_REGISTRY:-ghcr.io/wkarts}/pige360-api:${PIGE360_IMAGE_TAG:?PIGE360_IMAGE_TAG obrigatório}}
    pull_policy: ${PIGE360_PULL_POLICY:-missing}

  pige360-beat:
    <<: *worker-image
    environment:
      CELERY_WORKER_CONCURRENCY: ${PIGE360_WORKER_CONCURRENCY:-2}
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M

  pige360-worker-app-builds:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-app-distribution:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-visual-regression:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-default:
    <<: *worker-image
    command:
      - celery
      - -A
      - app.worker
      - worker
      - --loglevel=INFO
      - --queues=default,pedagogy,attendance,finance,fiscal,contracts,signatures,mail,notifications,documents,integrations,app-builds
      - --hostname=consolidated@%h
      - --concurrency=${PIGE360_WORKER_CONCURRENCY:-2}
    networks:
      - pige360-data
      - pige360-observability
      - pige360-build-farm
    secrets:
      - connect_api_key
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          memory: 512M

  pige360-worker-high-priority:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-academic:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-pedagogy:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-attendance:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-finance:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-banking:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-fiscal:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-sales:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-hr:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-mail:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-notifications:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-documents:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-contracts:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-signatures:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-worker-reports:
    <<: *worker-image
    profiles: [dedicated-workers]

  pige360-postgres-control:
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G

  pige360-postgres-tenants:
    deploy:
      resources:
        limits:
          cpus: '4.0'
          memory: 8G

secrets:
  connect_api_key:
    file: ${PIGE360_SECRETS_DIR:-./runtime-secrets}/connect_api_key.txt
  cloudflare_api_token:
    file: ${PIGE360_SECRETS_DIR:-./runtime-secrets}/cloudflare_api_token.txt
